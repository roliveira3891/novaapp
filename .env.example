# DB_DRIVER escolhe o banco: "mysql" (padrão, ambiente atual) ou "postgres"
# (servidor SEU_IP_AQUI). Sem essa variável, continua usando MySQL.
DB_DRIVER=mysql

# --- MySQL (ambiente atual) ---
# DB_HOST=SEU_IP_AQUI
# DB_PORT=3306
# DB_USER=ne
# DB_PASSWORD=
# DB_NAME=nova

# --- PostgreSQL (servidor 201) ---
# DB_DRIVER=postgres
# DB_HOST=SEU_IP_AQUI
# DB_PORT=5432
# DB_USER=iluminar_user
# DB_PASSWORD=
# DB_NAME=novaapp

AUTH_SECRET=
